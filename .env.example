# Runtime: demo | test | preview | production
CREATOR_RUNTIME_MODE=demo
NEXT_PUBLIC_CREATOR_RUNTIME_MODE=demo

# Supabase. Use the publishable key in browser/SSR caller-scoped clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Render worker. Real providers remain disabled until later milestones.
CREATOR_WORKER_BASE_URL=http://127.0.0.1:8090
CREATOR_WORKER_TOKEN=replace-with-a-long-random-value
CREATOR_PROVIDER_MODE=mock

# Script generation is manual/deterministic in the governed baseline.
SCRIPT_PROVIDER=manual
